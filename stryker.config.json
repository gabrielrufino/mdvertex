{
  "$schema": "https://schema.stryker-mutator.io/stryker-config.json",
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.test.ts"
  ]
}
